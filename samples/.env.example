# CNC_AgentCore 环境变量样板
# 复制为 .env 并填写真实值（.env 不入 git）

# ===== 数据库 =====
PG_CONNECTION_STRING=Host=localhost;Port=5432;Database=cnc_kb;Username=postgres;Password=your_password;Include Error Detail=true

# ===== DeepSeek (OpenAI 兼容协议) =====
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 硅基流动 =====
SILICONFLOW_API_KEY=sk-your-siliconflow-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ===== JWT 鉴权 =====
# 生产必改：用 openssl rand -base64 48 生成
JWT_SECRET=
JWT_TTL_SEC=86400
JWT_ISSUER=cnc-agent-core
JWT_ALGORITHM=HS256

# ===== 应用 =====
ASPNETCORE_URLS=http://localhost:8000
LOG_LEVEL=Information
RERANK_THRESHOLD=0.30
